includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - src

    excludePaths:
        - src/Models

    inferPrivatePropertyTypeFromConstructor: true

    ignoreErrors:
        # Config arrays and AI payload arrays are inherently mixed-value;
        # enforcing iterable value types here adds noise without safety benefit.
        - identifier: missingType.iterableValue
        # Collection generics are documented via @param phpdoc — suppress the constructor-level noise.
        - identifier: missingType.generics
