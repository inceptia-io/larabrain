{
    "name": "inceptia-io/larabrain",
    "description": "Give your CodeIgniter 4 application self-awareness. Scans entities, builds a context graph, and answers natural-language questions about your codebase via OpenAI, Gemini, Anthropic or DeepSeek.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/inceptia-io/larabrain",
    "authors": [
        {
            "name": "Arafat Hossain",
            "email": "hello@arafat.dev",
            "homepage": "https://arafat.dev",
            "role": "Developer"
        }
    ],
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "ai",
        "codebase",
        "assistant",
        "openai",
        "gemini",
        "anthropic",
        "deepseek",
        "context",
        "natural-language",
        "brain"
    ],
    "support": {
        "issues": "https://github.com/inceptia-io/larabrain/issues",
        "source": "https://github.com/inceptia-io/larabrain"
    },
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "phpstan/phpstan": "^1.0|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Arafat\\Brain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arafat\\Brain\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "quality": [
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
